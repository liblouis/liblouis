# liblouis: Spanish Chess Braille Table (CBE B 8 V2)
#
# -----------
#-index-name: Spanish, chess
#-display-name: Spanish chess braille
#
#+language:zxx
#+region:es
#+type:chess
#+system:cbe-b8
#+dots:6
#+direction:forward
# -----------
#
#  Copyright (C) 2026 by guiador <https://github.com/guiador>
