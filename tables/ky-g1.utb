# Kyrgyz Braille, uncontracted
# Basic Kyrgyz Braille code information can be found in World Braille Usage 3rd Edition (page 80)
# https://github.com/liblouis/braille-specs/blob/master/world-braille-usage-third-edition.pdf
# Additional information not present in WBU file, including extra punctuation and mathematics information was reverse-engineered from documents where the print and Braille versions could be compared
# And derived from Kyrgyz Braille standard КМС 1368:2023 (in Kyrgyz, not easily available)
# Which in turn is heavily based on, but not identical to, gost_r_58511-2019 (in Russian):
# https://rosgosts.ru/file/gost/11/180/gost_r_58511-2019.pdf

include spaces.uti

# Most Cyrillic letters get the normal translations
include cyrillicLetterDef6Dots.uti

# And some extra letters for Kyrgyz
lowercase й 12346
lowercase ң 13456
lowercase ө 34
lowercase ү 1236

base uppercase Й й
base uppercase Ң ң
base uppercase Ө ө
base uppercase Ү ү

# Basic punctuation
punctuation . 256
punctuation , 2
punctuation ? 236
punctuation ; 23
punctuation : 25
punctuation - 36
punctuation ' 3
punctuation ! 235
sign _ 456
sign $ 4-256
sign % 25-1234
sign & 4-12346

punctuation ( 2356
punctuation ) 2356
prepunc ( 2356
postpunc ) 2356
punctuation " 356
prepunc " 236
postpunc " 356
punctuation [ 6-2356
punctuation ] 2356-3

# numbers
include digits6Dots.uti
include litdigits6Dots.uti
numsign 3456
numericmodechars .,

# Mathematics symbols
math + 56-236
math - 56-36
math * 35-35
math / 56-34
math = 56-2356

# Attributes
capsletter 46

# Latin compatibility
# Note: does not work in backward translation
# See https://github.com/liblouis/liblouis/issues/2106 for more information
# Latin input is not a core requirement, so forward-only function until the underlying bug can be fixed is considered acceptable
begmode latin 6
include cyrillicTableLatinCompatibility.uti


# Mathematics uses Russian Braille standard
include ru-math.uti

include braille-patterns.cti