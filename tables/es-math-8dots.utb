# -------------------------------------------------------------------------------
#  Spanish 8-dot Braille Mathematical Code
#  Based on Comisión Braille Española (CBE / ONCE):
#  Documento técnico B 14-1: Código matemático de ocho puntos, Versión 3
#  (marzo de 2019).
#
#  Note: Built standalone over digits6DotsPlusDot6.uti and latinLetterDef8Dots.uti
#  (rather than including Es-Es-G0.utb directly) so CBE B 14-1 V3 overrides of
#  8-dot delimiters and operators (<, >, /, *, ×, ·, ±, °, [, ], {, }) take
#  precedence deterministically.
# -------------------------------------------------------------------------------

space \s 0
space \t 9
space \x001B 1b
space \x000A 0
space \x000D 0
space \x00A0 0

include braille-patterns.cti

# 1. Cifras (B 14-1 V3 §1): digits 1-9 use dot 6 without numsign; 0 is 34678
digit 0 34678
include digits6DotsPlusDot6.uti

# 2. Caracteres latinos (B 14-1 V3 §2) y letras españolas (CBE B 15 V2)
include latinLetterDef8Dots.uti

lowercase \x00E1 12356       # á
lowercase \x00E9 2346        # é
lowercase \x00ED 34          # í
lowercase \x00F3 346         # ó
lowercase \x00FA 23456       # ú
lowercase \x00FC 12568       # ü
lowercase \x00F1 124568      # ñ
lowercase \x00E7 123468      # ç
lowercase \x00E0 123568      # à
lowercase \x00E8 23468       # è
lowercase \x00EC 348         # ì
lowercase \x00F2 3468        # ò
lowercase \x00F9 234568      # ù

uppercase \x00C1 123567      # Á
uppercase \x00C9 23467       # É
uppercase \x00CD 347         # Í
uppercase \x00D3 3467        # Ó
uppercase \x00DA 234567      # Ú
uppercase \x00DC 125678      # Ü
uppercase \x00D1 124567      # Ñ
uppercase \x00C7 1234678     # Ç

