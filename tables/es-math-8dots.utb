# 5. Delimitadores y puntuación matemática (B 14-1 V3 §5)
punctuation ( 1268
punctuation ) 3457
punctuation [ 23678
punctuation ] 35678
punctuation { 1238
punctuation } 4567
punctuation \x27E8 2348     # ⟨ paréntesis angular izq
punctuation \x27E9 1567     # ⟩ paréntesis angular der
punctuation \x2329 2348     # 〈
punctuation \x232A 1567     # 〉
punctuation . 3             # punto de millar / separación
punctuation , 2             # coma decimal / separación
punctuation ; 23            # punto y coma
punctuation : 25            # dos puntos
sign \x2026 3-3-3           # … puntos suspensivos
sign / 8-3                  # barra oblicua
sign \x005C 6-7             # \ barra inversa
sign | 4568                 # barra vertical
sign \x2013 36              # –
sign \x2014 36              # —

# 6. Conjuntos (B 14-1 V3 §6) & 16. Conjuntos numéricos
math \x222A 568-567         # ∪ unión
math \x2229 568-268         # ∩ intersección
math \x2216 568-36          # ∖ diferencia de conjuntos
math \x2296 568-368         # ⊖ diferencia simétrica
math \x2A2F 568-378         # ⨯ producto cartesiano
math \x22C3 568-5678-25-15678  # ⋃ unión de una familia
math \x22C2 568-2568-25-15678  # ⋂ intersección de una familia
math \x2282 1267            # ⊂ incluido
math \x2283 3458            # ⊃ contiene
math \x2286 12678           # ⊆ incluido o igual
math \x2287 34578           # ⊇ contiene o es igual
math \x2284 458-1267        # ⊄ no incluido
math \x2285 458-3458        # ⊅ no contiene
math \x2288 458-12678       # ⊈ no incluido ni igual
math \x2289 458-34578       # ⊉ no contiene ni es igual
math \x2208 238             # ∈ perteneciente
math \x220B 567             # ∋ comprende como elemento
math \x2209 458-238         # ∉ no perteneciente
math \x220C 458-567         # ∌ no comprende como elemento
math \x2118 568-2357        # ℘ potencia de un conjunto
math \x2205 568-356         # ∅ conjunto vacío
math \x2135 12567           # ℵ Aleph
math \x2115 568-13457       # ℕ naturales
math \x2124 568-13567       # ℤ enteros
math \x211A 568-123457      # ℚ racionales
math \x211D 568-12357       # ℝ reales
math \x2102 568-147         # ℂ complejos
math \y1D540 568-247        # 𝕀 irracionales

# 7. Operadores aritméticos (B 14-1 V3 §7)
math + 235                  # suma
math - 36                   # resta
math \x2212 36              # − resta Unicode
math \x00D7 236             # × multiplicación (aspa)
math \x00B7 37              # · multiplicación (punto)
math \x22C5 37              # ⋅ multiplicación (dot operator)
math * 256                  # * división ASCII (B 14-1 §7)
math \x00F7 2578            # ÷ división
math \x00B1 235-36          # ± más o menos
math \x2213 36-235          # ∓ menos o más
sign ! 2357                 # ! factorial
sign \x203C 2357-2357       # ‼ doble factorial
sign % 456                  # % tanto por ciento
sign \x2030 456-3           # ‰ tanto por mil
math \x2217 56-3            # ∗ operador genérico

# 8. Relaciones (B 14-1 V3 §8)
math < 358                  # < menor que
math > 267                  # > mayor que
math \x2264 3578            # ≤ menor o igual
math \x2265 2678            # ≥ mayor o igual
math \x226A 358-358         # ≪ mucho menor que
math \x226B 267-267         # ≫ mucho mayor que
math \x227A 6-358           # ≺ anterior
math \x227B 267-3           # ≻ posterior
math \x2223 4568-2          # ∣ divisor
math \x223C 2358            # ∼ semejante o similar
math \x2241 458-2358        # ≁ no semejante
math = 2356                 # = igual
math \x2248 23567           # ≈ aproximado
math \x221D 23568           # ∝ proporcional
math \x2261 235678          # ≡ idéntico o equivalente
math \x2262 458-235678      # ≢ no idéntico
math \x2245 5-2356          # ≅ congruente con
math \x2260 458-2356        # ≠ distinto de
math \x226E 458-2368        # ≮ no menor que (B 14-1 §8 ej.)
math \x226F 458-267         # ≯ no mayor que
math \x2270 458-3578        # ≰ no menor ni igual
math \x2271 458-2678        # ≱ no mayor ni igual

# 9. Lógica (B 14-1 V3 §9)
math \x2228 1358            # ∨ o (disyunción lógica)
math \x2227 134568          # ∧ y (conjunción lógica)
math \x22BB 13578           # ⊻ disyunción excluyente
math \x00AC 458             # ¬ no (negación lógica)
math \x2200 28              # ∀ para todo
math \x2203 268             # ∃ existe
always \x2203! 268-3        # ∃! existe un único
math \x2204 458-268         # ∄ no existe
math \x22A4 123567          # ⊤ tautología
math \x22A5 234568          # ⊥ contradicción
math \x21D2 36-2367         # ⇒ implicación
math \x21D4 3568-36-2367    # ⇔ equivalencia lógica
math \x21D0 3568-36         # ⇐ implicación recíproca
math \x2234 8-28            # ∴ por lo tanto

# 10. Álgebra y 13. Análisis y cálculo (B 14-1 V3 §§10, 13)
math ^ 45                   # exponente simple
math \x2044 2568           # ⁄ barra de fracción simple
math \x221A 12468          # √ raíz cuadrada simple
math \x2211 4-23478-15678  # ∑ sumatorio
math \x220F 4-123478-25-15678  # ∏ productorio
