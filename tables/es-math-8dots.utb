math \x2202 4-14568        # ∂ derivada parcial
math \x222B 4-123468       # ∫ integral
math \x222C 4-123468-123468         # ∬ integral doble
math \x222D 4-123468-123468-123468  # ∭ integral triple
math \x222E 5-123468       # ∮ integral de contorno
math \x2206 2468           # ∆ operador laplaciano
math \x2207 2467           # ∇ operador nabla

# 11. Geometría y 14. Flechas y 16. Otros símbolos (B 14-1 V3 §§11, 14, 16)
math \x2225 123456         # ∥ paralela con
