#-index-name: Basque
#-display-name: Basque braille

#+language:eu
#+type:literary
#+contraction:no
#+grade:1

# Basque (Euskara) literary braille uses the Spanish braille character set and
# rules (including ç and accented foreign letters) per Comisión Braille Española
# (CBE) B 2 V4 (2025-05-23), §5.3.

include es-g1.ctb
include braille-patterns.cti
