match %a sekali (%[_.^]|%a) 3456-13
match - sekali ((%[_^]|%1)|%a) 3456-13
match %a selalu (%[_.^]|%a) 3456-123
match - selalu ((%[_^]|%1)|%a) 3456-123
match %a sebelum (%[_.^]|%a) 3456-134
match - sebelum ((%[_^]|%1)|%a) 3456-134
