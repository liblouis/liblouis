# Back-translation (braille to text). The match rules above are used
# only in forward translation, so the signs they write are read back by
# the nofor rules below. Where the braille is ambiguous, these rules
# follow Tarsidi: a part-word sign is read as such inside a word, a
# single cell between spaces is a word sign, and a cell that is also a
# punctuation mark is read as the mark at the end of a word.
# Cells that are also punctuation marks after a word (dots 2-3, 2-5,
# 2-3-5, 2-3-6, 2-5-6, 3-5-6, 2-3-5-6) are read back with begword and
# midword rules, and the lower signs with context rules, so that a
# word sign followed by the mark is still found: "lagi." is not read
# as "g" followed by the lower sign dengan.
# Lower signs between spaces (Modul 5.1.3), also with the capital sign.
# Where id-id-g1.utb has a prepunc or postpunc rule for the cell (dots
# 2-3-6, 2-3-5-6 and 3-5-6), which would be tried first, the rule takes
# in the space before the sign (or after it, at the start of the text);
# agar and supaya that are the whole text are found by lowword rules,
# but masih is then read as the quotation mark.
nofor context [@0-2356]@0 "\sagar"
nofor context [@0-2356]~ "\sagar"
nofor context `[@2356-0] "agar\s"
nofor context [@0-6-2356]@0 "\sAgar"
nofor context [@0-6-2356]~ "\sAgar"
nofor context `[@6-2356-0] "Agar\s"
nofor context `[@6-2356]~ "Agar"
nofor lowword agar 2356
nofor context `[@23]~ "bahwa"
nofor context `[@6-23]~ "Bahwa"
nofor context `[@23]$s "bahwa"
nofor context `[@6-23]$s "Bahwa"
nofor context _$s[@23]~ "bahwa"
nofor context _$s[@6-23]~ "Bahwa"
nofor context _$s[@23]$s "bahwa"
nofor context _$s[@6-23]$s "Bahwa"
nofor context `[@256]~ "dengan"
nofor context `[@6-256]~ "Dengan"
nofor context `[@256]$s "dengan"
nofor context `[@6-256]$s "Dengan"
nofor context _$s[@256]~ "dengan"
nofor context _$s[@6-256]~ "Dengan"
nofor context _$s[@256]$s "dengan"
nofor context _$s[@6-256]$s "Dengan"
nofor context `[@35]~ "ia"
nofor context `[@6-35]~ "Ia"
nofor context `[@35]$s "ia"
nofor context `[@6-35]$s "Ia"
nofor context _$s[@35]~ "ia"
nofor context _$s[@6-35]~ "Ia"
nofor context _$s[@35]$s "ia"
nofor context _$s[@6-35]$s "Ia"
nofor context `[@235]~ "maka"
nofor context `[@6-235]~ "Maka"
nofor context `[@235]$s "maka"
nofor context `[@6-235]$s "Maka"
nofor context _$s[@235]~ "maka"
nofor context _$s[@6-235]~ "Maka"
nofor context _$s[@235]$s "maka"
nofor context _$s[@6-235]$s "Maka"
nofor context [@0-236]@0 "\smasih"
nofor context [@0-236]~ "\smasih"
nofor context `[@236-0] "masih\s"
nofor context [@0-6-236]@0 "\sMasih"
nofor context [@0-6-236]~ "\sMasih"
nofor context `[@6-236-0] "Masih\s"
nofor context `[@6-236]~ "Masih"
nofor context `[@26]~ "memang"
nofor context `[@6-26]~ "Memang"
nofor context `[@26]$s "memang"
nofor context `[@6-26]$s "Memang"
nofor context _$s[@26]~ "memang"
nofor context _$s[@6-26]~ "Memang"
nofor context _$s[@26]$s "memang"
nofor context _$s[@6-26]$s "Memang"
nofor context [@0-356]@0 "\ssupaya"
nofor context [@0-356]~ "\ssupaya"
