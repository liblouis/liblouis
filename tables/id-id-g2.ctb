word kemudian 45-1456
match - kemudian (%[_.^]|%3) 45-1456
word tunanetra 45-156
match - tunanetra (%[_.^]|%0|[nN][gGyY]) 45-156
word terus 45-1256
always terus 45-1256
match %a seluruh (%[_.^]|%a) 45-12346
