word atur 45-1
always atur 45-1
word mungkin 45-134
match - mungkin (%[_.^]|%3) 45-134
word buka 45-12
match - buka (%[_.^]|%0|[nN][gGyY]) 45-12
word nurani 45-1345
always nurani 45-1345
word cukup 45-14
always cukup 45-14
word punya 45-1234
match - punya (%[_.^]|%0|[nN][gGyY]) 45-1234
word duduk 45-145
always duduk 45-145
word khusus 45-12345
always khusus 45-12345
word engkau 45-15
always engkau 45-15
