# Notes
# -----
# This table implements Tusing (Sistem Tulisan Singkat Braille
# Indonesia), the contracted Indonesian braille of Sistem Simbol Braille
# Indonesia Bidang Bahasa Indonesia, Keputusan Menteri Pendidikan
# Nasional Nomor 053/U/2000 (Departemen Pendidikan Nasional, Jakarta,
# 2000).
#
# The signs and rules were taken from Didi Tarsidi, Belajar Braille
# dalam 6 Modul (Universitas Pendidikan Indonesia, 2010): Modul 5,
# Tusing (Bagian I): Tanda Kata, and Modul 6, Tusing (Bagian II): Tanda
# Bagian Kata dan Sibra, with the lists of Appendix 1 to 3. The comment
# before each group of rules gives its section. The signs were checked
# against the Tusing help of Mitranetra Braille Converter 5 (Yayasan
# Mitra Netra), whose translator Modul 6.5 recommends for producing
# Tusing, and the output was compared with it.
#
# Letters, numbers, capitals, emphasis, punctuation and symbols are
# those of the uncontracted table, id-id-g1.utb.
#
# When a word can be contracted in several ways, the course prefers the
# contraction that makes a syllable, the earlier syllable, and the
# shortest result (Modul 6.4.3). liblouis takes the longest contraction
# at each position from left to right, which mostly gives the same
# result. The rules below add the checks that the course states
# explicitly. Some choices that need the whole word are not made the
# way the course prefers, for example kemasan (ke-mas-an, the course
# prefers k-emas-an) and Drupada (D-rupa-da, the course prefers
# Dru-pada).
#
# Not done: the letter sign before a group of letters that could be
# read as a contraction (only single letters get it), lower-case Roman
# numerals (ii, iii), and abbreviations written in capitals (SMU), which
# the course writes without contractions.
#
# Back-translation reads the signs back with the nofor rules at the end
# of the table. Where the braille can be read in two ways, the reading
# that the course's rules imply is chosen: a part-word sign inside a
# word, a word sign between spaces, a punctuation mark at the end of a
# word, a letter after tanda pugar or next to a hyphen, a period or an
# apostrophe. Some braille is ambiguous and is read the other way: dots
# 3-4-5 before b or p are read as am (sembilanbelas comes back as
# sembilambelas), but as an before pun (kapanpun); dots 3-4 between
# letters are di (siang/malam comes back as siangdimalam); a Sibra after
# a prefix wins over letters (membran comes back as membaruan); a Sibra
# wins at the start of a word (ski comes back as sukai); a capital
# before the repeat sign is not repeated (Guru-guru; Guru-Guru is
# written in full); and a single letter with a period is a word sign
# (P. comes back as Pada.).

# Repetition (Modul 6.1.2, tanda ulang dots 1-2-6). The repeat sign
# follows the word, which may be contracted: ibu-ibu, mobil-mobil. A
# prefix is followed by a hyphen and a suffix follows the repeat sign:
# berlari-lari, sedalam-dalamnya. These rules come before the hyphen
# of id-id-g1.utb.
# liblouis takes any part at the end of the first word that equals the
# start of the second as the repeated root, even a single letter. A
# hyphen before a capital is therefore kept as a hyphen (Jakarta-Ambon),
# and a word repeated with a capital is written twice, as Mitranetra
# Braille Converter does (Bangsa-Bangsa), so that it is read back with
# the capital. The hyphen is also kept after the prefixes anti, non,
# pra, pasca and the like (anti-imperialis).
match %a \x002d %u 36
# mereka-reka is me- and the repeated root reka, not the word sign mereka.
match - mereka-reka - 26-36-1235-15-13-1-126
match %[_.^][aA][nN][tT][iI] \x002d [iI] 36
match %[_.^][nN][oO][nN] \x002d [nN] 36
match %[_.^][pP][rR][aA] \x002d [aA] 36
match %[_.^][pP][aA][sS][cC][aA] \x002d [aA] 36
match %[_.^][pP][rR][oO] \x002d [oO] 36
match %[_.^][sS][eE][mM][iI] \x002d [iI] 36
match %[_.^][mM][uU][lL][tT][iI] \x002d [iI] 36
match %[_.^][uU][lL][tT][rR][aA] \x002d [aA] 36
match %[_.^][iI][nN][tT][eE][rR] \x002d [rR] 36
match %[_.^][iI][nN][tT][rR][aA] \x002d [aA] 36
match %[_.^][sS][uU][pP][rR][aA] \x002d [aA] 36
match %[_.^][mM][iI][nN][iI] \x002d [iI] 36
repword - 126
rependword - 36,126

# supaya between spaces (Modul 5.1.3), read back before the rule of
# id-id-g1.utb that reads dots 3-5-6 between spaces as ">".
nofor context [@0-356-0-236]@0 "\ssupaya\smasih"
nofor context [@0-356-0] "\ssupaya\s"

include id-id-g1.utb

# No capital sign before the repeat sign (Guru-Guru).
noback pass2 @6-126 @126
noback pass2 @6-6-126 @126

# Tanda pugar, dots 5-6 (Modul 6.4.2), before a letter standing alone,
# which would otherwise be read as a word sign: Pilihlah a, b atau c;
# sinar X. Before a capital it comes first, as in id-id-g1.utb. It is
# not used next to a period (a.n., A.H. Nasution) or an apostrophe, nor
# before a hyphen (e-mail).
letsign 56
# After a number the uncontracted table already writes tanda pugar
# before a letter a-j, so it is written only once, as in kelas 3A.
noback pass3 @56-56 @56
noletsignafter -.\x0027\x2019
noletsignbefore .\x0027\x2019
# A letter with a period at the end of the text is a letter, not an
# abbreviation, and keeps the sign: Pilihlah a, b atau c.
match %[_.^] a [.]^ 56-1
match %[_.^] b [.]^ 56-12
match %[_.^] c [.]^ 56-14
match %[_.^] d [.]^ 56-145
match %[_.^] e [.]^ 56-15
match %[_.^] f [.]^ 56-124
match %[_.^] g [.]^ 56-1245
match %[_.^] h [.]^ 56-125
match %[_.^] i [.]^ 56-24
match %[_.^] j [.]^ 56-245
match %[_.^] k [.]^ 56-13
match %[_.^] l [.]^ 56-123
match %[_.^] m [.]^ 56-134
match %[_.^] n [.]^ 56-1345
match %[_.^] o [.]^ 56-135
match %[_.^] p [.]^ 56-1234
match %[_.^] q [.]^ 56-12345
match %[_.^] r [.]^ 56-1235
match %[_.^] s [.]^ 56-234
match %[_.^] t [.]^ 56-2345
match %[_.^] u [.]^ 56-136
match %[_.^] v [.]^ 56-1236
match %[_.^] w [.]^ 56-2456
match %[_.^] x [.]^ 56-1346
match %[_.^] y [.]^ 56-13456
match %[_.^] z [.]^ 56-1356

# Character classes for the match rules below. A match rule gives
# the text before and after the contracted letters; see the liblouis
# manual. %[_.^] is a space, a punctuation mark or the edge of the text.
attribute 0 abcdefghjklmopqrstvwxyzABCDEFGHJKLMOPQRSTVWXYZ # letters that may follow a sign ending in a (not i, n or u)
attribute 1 .,;:?!\x0027\x2018\x2019"\x201c\x201d()[]{}/\x2026 # punctuation other than the hyphen
attribute 2 abcdefghijklmnopqstuvwxyzABCDEFGHIJKLMNOPQSTUVWXYZ # letters other than r
attribute 4 abcdefhijklmnopqrstuvwxyzABCDEFHIJKLMNOPQRSTUVWXYZ # letters other than g
attribute 3 abcdefhijklmnopqrstuvwxzABCDEFHIJKLMNOPQRSTUVWXZ # letters that may follow a sign ending in n (not g, not y)
attribute 5 abcdfghijklmnopqrstuvwxyzABCDFGHIJKLMNOPQRSTUVWXYZ # letters that may follow st (not e)
attribute 6 bcdefghijklmnopqrstvwxyzBCDEFGHIJKLMNOPQRSTVWXYZ # letters that may follow tak (not a or u)
attribute 7 abcdefghjklmnopqrstuvwxyzABCDEFGHJKLMNOPQRSTUVWXYZ # letters that may follow nya (not i)

# Several contractions must not be used where they would split a
# diphthong or a consonant pair, or where a better one starts on their
# last letter (Modul 6.4.3, "Berbagai kemungkinan penusingan"):
# - ng and ny are never split: a sign ending in n is not used before
#   g or y (bangun is ba-ng-un, hanyut is ha-ny-ut).
# - ai is never split: a sign ending in a is not used before i
#   (landai is l-an-d-ai, not l-anda-i).
# - an is preferred: a sign ending in a is not used before an n that
#   begins an (tanah is t-an-ah, makan is ma-kan, penelitian is
#   pe-neliti-an). The n of ng and ny may follow (sayang is saya-ng).
#   nya, a syllable by itself, may come before n (dinyana).
# - au is not split either: a sign ending in a is not used before u
#   (galau is gal-au, not g-ala-u).
# - tak is not used before u or an, where ku and kan make a syllable
#   (terletak, taksi, but ta-ku-t and ceta-kan).
# The rules that need these checks are written with match.

# A single-cell word sign that is repeated takes dots 4-5-6 first:
# lagi-lagi, jangan-jangan, satu-satunya, seakan-akan (Modul 6.1.2).
# A repeated lower sign is spelled out: agar-agar (Modul 5.1.3).
match - aksi -[aA][kK][sS][iI] 456-1346
match - anda -[aA][nN][dD][aA] 456-1
match - bagi -[bB][aA][gG][iI] 456-12
match - cara -[cC][aA][rR][aA] 456-14
match - dari -[dD][aA][rR][iI] 456-145
match - emas -[eE][mM][aA][sS] 456-15
match - faktor -[fF][aA][kK][tT][oO][rR] 456-124
match - harus -[hH][aA][rR][uU][sS] 456-125
match - ini -[iI][nN][iI] 456-1345
match - itu -[iI][tT][uU] 456-24
match - jadi -[jJ][aA][dD][iI] 456-245
match - karena -[kK][aA][rR][eE][nN][aA] 456-1235
match - kita -[kK][iI][tT][aA] 456-13
match - kualitas -[kK][uU][aA][lL][iI][tT][aA][sS] 456-12345
match - lagi -[lL][aA][gG][iI] 456-1245
match - lalu -[lL][aA][lL][uU] 456-123
match - mereka -[mM][eE][rR][eE][kK][aA] 456-134
match - oleh -[oO][lL][eE][hH] 456-135
match - pada -[pP][aA][dD][aA] 456-1234
match - saya -[sS][aA][yY][aA] 456-234
match - tak -[tT][aA][kK] 456-2345
match - untuk -[uU][nN][tT][uU][kK] 456-136
match - vitamin -[vV][iI][tT][aA][mM][iI][nN] 456-1236
match - waktu -[wW][aA][kK][tT][uU] 456-2456
match - yang -[yY][aA][nN][gG] 456-13456
match - zat -[zZ][aA][tT] 456-1356
match - atau -[aA][tT][aA][uU] 456-246
match - buat -[bB][uU][aA][tT] 456-346
match - bukan -[bB][uU][kK][aA][nN] 456-1246
match - jangan -[jJ][aA][nN][gG][aA][nN] 456-12456
match - kamu -[kK][aA][mM][uU] 456-146
match - nyata -[nN][yY][aA][tT][aA] 456-2346
match - satu -[sS][aA][tT][uU] 456-156
match - sebagai -[sS][eE][bB][aA][gG][aA][iI] 456-3456
match - serta -[sS][eE][rR][tT][aA] 456-12346
match - telah -[tT][eE][lL][aA][hH] 456-1256
match - agar -[aA][gG][aA][rR] 1-1245-1-1235
match - bahwa -[bB][aA][hH][wW][aA] 12-1-125-2456-1
match - dengan -[dD][eE][nN][gG][aA][nN] 145-15-1345-1245-1-1345
match - maka -[mM][aA][kK][aA] 134-1-13-1
match - masih -[mM][aA][sS][iI][hH] 134-1-234-24-125
match - memang -[mM][eE][mM][aA][nN][gG] 134-15-134-1-1345-1245
match - supaya -[sS][uU][pP][aA][yY][aA] 234-136-1234-1-13456-1
match - akan -[aA][kK][aA][nN] 456-12356
match - aku -[aA][kK][uU] 456-23456
match - dan -[dD][aA][nN] 456-345
match - hingga -[hH][iI][nN][gG][gG][aA] 456-123456
match - sampai -[sS][aA][mM][pP][aA][iI] 456-16

# Word signs (Modul 5.1). A single cell stands for a whole word. It may
# carry punctuation, the capital sign and the italic sign.
# Modul 5.1.1: letters
word aksi 1346
word anda 1
word bagi 12
word cara 14
word dari 145
word emas 15
word faktor 124
word harus 125
word ini 1345
word itu 24
word jadi 245
word karena 1235
word kita 13
word kualitas 12345
word lagi 1245
word lalu 123
word mereka 134
word oleh 135
word pada 1234
word saya 234
word tak 2345
word untuk 136
word vitamin 1236
word waktu 2456
word yang 13456
word zat 1356
# Modul 5.1.2: reversed letters
word atau 246
word buat 346
word bukan 1246
word jangan 12456
word kamu 146
word ke 1456
word nyata 2346
word satu 156
word sebagai 3456
word serta 12346
word telah 1256
# Modul 5.1.3: lower signs
# The lower signs are used only between spaces, never next to a
# punctuation mark (Modul 5.1.3, rule 1): "Ia masih lemas." is
# written with the letters of Ia.
noback lowword agar 2356
noback lowword bahwa 23
noback lowword dengan 256
noback lowword ia 35
noback lowword maka 235
noback lowword masih 236
noback lowword memang 26
noback lowword supaya 356
# Modul 5.1.4: other signs
word akan 12356
word aku 23456
word dan 345
word di 34
word hingga 123456
word sampai 16

# Allah is not contracted: its lah is not the particle lah.
word allah 1-123-123-1-125

# Word signs with dot 5, dots 4-5, dot 4 and dots 3-4-5-6 (Modul 5.2,
# 5.3 and 5.4). They are word signs and part-word signs, anywhere in a
# word: dalam, sedalam, Wiguna, diganggu.
# Modul 5.2.1
word baik 5-12
always baik 5-12
word orang 5-135
always orang 5-135
word capai 5-14
always capai 5-14
word pakai 5-1234
always pakai 5-1234
word dalam 5-145
always dalam 5-145
word kuantitas 5-12345
always kuantitas 5-12345
word erat 5-15
always erat 5-15
word rakyat 5-1235
always rakyat 5-1235
word fakta 5-124
match - fakta (%[_.^]|%0|[nN][gGyY]) 5-124
word sangat 5-234
always sangat 5-234
word ganti 5-1245
always ganti 5-1245
word tahu 5-2345
always tahu 5-2345
word hari 5-125
always hari 5-125
word ubah 5-136
always ubah 5-136
word ikat 5-24
always ikat 5-24
word variasi 5-1236
always variasi 5-1236
word jalan 5-245
match - jalan (%[_.^]|%3) 5-245
word walau 5-2456
always walau 5-2456
word kali 5-13
always kali 5-13
word laksana 5-1346
match - laksana (%[_.^]|%0|[nN][gGyY]) 5-1346
word lain 5-123
match - lain (%[_.^]|%3) 5-123
word yakin 5-13456
match - yakin (%[_.^]|%3) 5-13456
word mana 5-134
match - mana (%[_.^]|%0|[nN][gGyY]) 5-134
word zakat 5-1356
always zakat 5-1356
word naik 5-1345
always naik 5-1345
# Modul 5.2.2
word diri 5-34
always diri 5-34
word muka 5-146
match - muka (%[_.^]|%0|[nN][gGyY]) 5-146
word suara 5-346
match - suara (%[_.^]|%0|[nN][gGyY]) 5-346
word sama 5-156
match - sama (%[_.^]|%0|[nN][gGyY]) 5-156
word antara 5-345
match - antara (%[_.^]|%0|[nN][gGyY]) 5-345
word terang 5-1256
always terang 5-1256
word kerja 5-1456
match - kerja (%[_.^]|%0|[nN][gGyY]) 5-1456
word nyanyi 5-1246
always nyanyi 5-1246
match %a sebab (%[_.^]|%a) 5-12346
match - sebab ((%[_^]|%1)|%a) 5-12346
word kuasa 5-23456
match - kuasa (%[_.^]|%0|[nN][gGyY]) 5-23456
word tinggal 5-123456
always tinggal 5-123456
