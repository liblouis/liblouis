# Signs for the start and the middle of a word (Modul 6.2.1). At the end
# of a word ber, per and ter are written be-r, pe-r and te-r.
# ber, ter and per are not used before a reduplicated root that starts
# with r, so that the root can be repeated: beramai-ramai is be-ramai<.
noback begmidword be 23
noback begmidword pe 25
match - ter %a+(%[_^]|%1|[-]%2|[-]%[_.^]) 356
match - ber %a+(%[_^]|%1|[-]%2|[-]%[_.^]) 235
match - per %a+(%[_^]|%1|[-]%2|[-]%[_.^]) 256

# Signs for the middle of a word (Modul 6.2.2). in and un are im and um
# before b or p.
# ngg is not used before a reduplicated root that starts with g:
# menggebu-gebu is me-ng-gebu<.
match %a aa (%0|[nN][gGyY]) 2
match %a in %3 2356
match %a im [bBpP] 2356
match %a un %3 236
match %a um [bBpP] 236
match %a ngg %a+(%[_^]|%1|[-]%4|[-]%[_.^]) 123456

