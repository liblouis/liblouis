always ikut 45-24
word volume 45-1236
always volume 45-1236
word juru 45-245
always juru 45-245
word wujud 45-2456
always wujud 45-2456
word kurang 45-13
always kurang 45-13
word maksud 45-1346
always maksud 45-1346
word luar 45-123
always luar 45-123
# Modul 5.3.2
word kemudian 45-1456
match - kemudian (%[_.^]|%3) 45-1456
word tunanetra 45-156
match - tunanetra (%[_.^]|%0|[nN][gGyY]) 45-156
word terus 45-1256
always terus 45-1256
