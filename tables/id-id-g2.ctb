match - senang ((%[_^]|%1)|%a) 3456-1345
match %a seperti (%[_.^]|%a) 3456-1234
match - seperti ((%[_^]|%1)|%a) 3456-1234
match %a sekarang (%[_.^]|%a) 3456-1235
match - sekarang ((%[_^]|%1)|%a) 3456-1235
match %a sesuai (%[_.^]|%a) 3456-234
match - sesuai ((%[_^]|%1)|%a) 3456-234
match %a sedang (%[_.^]|%a) 3456-12456
match - sedang ((%[_^]|%1)|%a) 3456-12456
match %a sedangkan (%[_.^]|%3) 3456-12356
match - sedangkan ((%[_^]|%1)|%3) 3456-12356
match %a sendiri (%[_.^]|%a) 3456-34
match - sendiri ((%[_^]|%1)|%a) 3456-34
match %a semua (%[_.^]|%0|[nN][gGyY]) 3456-346
match - semua ((%[_^]|%1)|%0|[nN][gGyY]) 3456-346
match %a setelah (%[_.^]|%a) 3456-1256
match - setelah ((%[_^]|%1)|%a) 3456-1256
