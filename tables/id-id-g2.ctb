match - selesai ((%[_^]|%1)|%a) 3456-16
match %a sehingga (%[_.^]|%0|[nN][gGyY]) 3456-123456
match - sehingga ((%[_^]|%1)|%0|[nN][gGyY]) 3456-123456
match %a sekunder (%[_.^]|%a) 3456-23456
match - sekunder ((%[_^]|%1)|%a) 3456-23456
# A word that starts with one of the signs for se... is not written with
# it before a hyphen, so that the root can be repeated: sekali-kali is
# se-kali<, semua-muanya is se-mua<nya, but bersenang-senang is
# ber-senang<.

# Single-cell word signs as part of a word (Modul 5.1, rule 3): dots
# 4-5-6 come first, as in kamus, melalui, sebagian, bayangan. The
# lower signs are not used at the end of a word (Modul 5.1.3, rule 2).
# ke, di and ia are part-word signs without dots 4-5-6 (see below).
# dan, aku and akan are left out: an, ku and kan are as short.
# ini is used only at the start of a word; elsewhere in-i is as short
# (sini is s-in-i; Modul 5.1.4 writes s-ini because in is taught only
# in Modul 6).
partword aksi 456-1346
match %a anda (%[_.^]|%0|[nN][gGyY]) 456-1
match - anda (%0|[nN][gGyY]) 456-1
partword bagi 456-12
match %a cara (%[_.^]|%0|[nN][gGyY]) 456-14
match - cara (%0|[nN][gGyY]) 456-14
partword dari 456-145
partword emas 456-15
partword faktor 456-124
partword harus 456-125
match %[_.^] ini %a 456-1345
partword itu 456-24
partword jadi 456-245
match %a karena (%[_.^]|%0|[nN][gGyY]) 456-1235
match - karena (%0|[nN][gGyY]) 456-1235
match %a kita (%[_.^]|%0|[nN][gGyY]) 456-13
match - kita (%0|[nN][gGyY]) 456-13
partword kualitas 456-12345
partword lagi 456-1245
partword lalu 456-123
match %a mereka (%[_.^]|%0|[nN][gGyY]) 456-134
