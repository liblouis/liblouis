#
#  You should have received a copy of the GNU Lesser General Public
#  License along with liblouis. If not, see
#  <http://www.gnu.org/licenses/>.
#
#-maintainer: James Bowden <james.bowden@rnib.org.uk>
#-author: Clive Lansink <clive@aicomms.co.nz>
#
include text_nabcc.dis
# Here I implement symbol 456 as the macron prefix indicating vowel macrons.
lowercase \x0101 456-1 ā
lowercase \x0113 456-15 ē
lowercase \x012b 456-24 ī
lowercase \x014d 456-135 ō
lowercase \x016b 456-136 ū
# The uppercase mappings are included as standard
# The following implements the combining macron character, Unicode 0x0304, which adds a macron to the character it follows. For capital letters with macrons, UEB requires the capitalisation indicator to come before the macron prefix. But I understand that when processing macrons indicated by this combining macron character, Lib Louis has a known limitation in that it applies the capitalisation indicator after the macron prefix. Also Lib Louis seems to incorrectly treat the combining macron character as terminating any existing capitalisation. 
sign \x0304 456 ̄ 
# Implement translation of wh. This is regarded as a single letter in the Māori language so this translation applies even in grade 1.
always	wh	156
# For everything else, fall back to normal UEB grade 1 translation. 
include en-ueb-g1.ctb
