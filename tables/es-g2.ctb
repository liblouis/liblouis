# Lower-cell contractions carrying virtual dot a for whole-word single-contraction check

sign \xe001 2a
sign \xe002 23a
sign \xe003 25a
sign \xe004 256a
sign \xe005 26a
sign \xe009 35a
sign \xe008 236a
sign \xe007 2356a
sign \xe006 235a
sign \xe000 356a

always ab 2a
always br 23a
always cr 25a
always dr 256a
always en 26a
always in 35a
always er 236a
always gr 2356a
always pr 235a
always tr 356a

attribute contraction \xe000\xe001\xe002\xe003\xe004\xe005\xe006\xe007\xe008\xe009
swapdd cancelcontraction 2a,23a,25a,256a,26a,35a,236a,2356a,235a,356a 1-12,12-1235,14-1235,145-1235,15-1345,24-1345,15-1235,1245-1235,1234-1235,2345-1235
swapdd finalizecontraction 2a,23a,25a,256a,26a,35a,236a,2356a,235a,356a 2,23,25,256,26,35,236,2356,235,356

# Cancel ONLY standalone single-contraction tokens (e.g. 'dr', 'pr', 'br') and
# abbreviations followed by period (e.g. 'Dr.' per CBE B 16-1 V3 §3.4.2 rule 4).
# Per CBE B 16-1 V3 §3.4.2 rule 2, multi-contraction lower-sign words (tren, trinen,
# drenen, graben, traben, entren, compren) stay contracted.
noback pass2 $s[%contraction]$s %cancelcontraction
noback pass2 $s[%contraction]~ %cancelcontraction
noback pass2 `[%contraction]$s %cancelcontraction
noback pass2 `[%contraction]~ %cancelcontraction
noback pass2 $s@46[%contraction]$s %cancelcontraction
noback pass2 $s@46[%contraction]~ %cancelcontraction
noback pass2 `@46[%contraction]$s %cancelcontraction
noback pass2 `@46[%contraction]~ %cancelcontraction
noback pass2 $s[%contraction]@3 %cancelcontraction
noback pass2 `[%contraction]@3 %cancelcontraction
noback pass2 $s@46[%contraction]@3 %cancelcontraction
noback pass2 `@46[%contraction]@3 %cancelcontraction

# Dot-5 interruption for words containing k or w (CBE B 16-1 V3 §4.2.1.1)
# Note: x is NOT uncontracted (see Apéndice A/C and §4.2.1.1).
nocont K
nocont W
nocont k
nocont w

lowercase k 13b
lowercase w 2456b
punctuation \x0021 235c
punctuation \x0022 236c
punctuation \x0028 126c
punctuation \x0029 345c
punctuation \x2013 36c
sign \x002A 35c
punctuation \x003B 23c
punctuation \x003F 26c
punctuation \x00A1 235c
punctuation \x00AB 236c
punctuation \x00BB 236c
punctuation \x00BF 26c
punctuation \x201C 236c
punctuation \x201D 236c

attribute kw kw
swapdd kw 13b,2456b 13,2456

# Virtual dot c classes and swap set for punctuation disambiguation (§§4.2.2-4.2.3)
sign \xe028 235c
sign \xe029 236c
sign \xe02a 126c
sign \xe02b 345c
sign \xe02c 23c
sign \xe02d 26c
sign \xe02e 35c
sign \xe02f 36c
attribute punctc \xe028\xe029\xe02a\xe02b\xe02c\xe02d\xe02e\xe02f
attribute openablec \xe028\xe029\xe02a\xe02d\xe02f
attribute closethreec \xe029\xe02d
attribute closeallc \xe028\xe029\xe02b\xe02d
attribute notbeforeclose \xe028\xe029\xe02a\xe02b\xe02d\x0020
attribute kwbound \xe028\xe029\xe02a\xe02b\xe02c\xe02d\xe02e\x0020KWkw
swapdd punctc 235c,236c,126c,345c,23c,26c,35c,36c 235,236,126,345,23,26,35,36

# Step A (pass2): Place dot 5 on k/w words. If opening punctuation precedes the word
# (e.g. ¿bikini?), dot 5 goes AFTER opening punctuation per §4.2.3.1a.
noback pass2 _$s[%kw] @5*
noback pass2 _$s[!%kwbound.%kw] @5*
noback pass2 _%openablec[%kw] @5*
noback pass2 _%openablec[!%kwbound.%kw] @5*
noback pass2 `[%kw] @5*
noback pass2 `[!%kwbound.%kw] @5*
# Comma immediately after '-ab' contraction receives dot 5 (CBE B 16-1 V3 §4.2.2.6 Tabla 23)
noback pass2 _@2a[@2] @5-2
noback pass2 %contraction %finalizecontraction

# Step C (pass3): Multiple closing signs get dot 5 before the FIRST closing sign only,
# and single Tabla-23 closing signs (?, ", », ”) get dot 5 before them (§4.2.2 Tabla 23).
# Must precede Step B so '!»' / '?"' / '?!' hit Step C instead of Step B's %openablec no-op.
noback pass3 _!%notbeforeclose[@235c]%closeallc @5-235c
noback pass3 _!%notbeforeclose[@236c]%closeallc @5-236c
noback pass3 _!%notbeforeclose[@345c]%closeallc @5-345c
noback pass3 _!%notbeforeclose[@26c]%closeallc @5-26c
noback pass3 _!%notbeforeclose[@236c]$s @5-236c
noback pass3 _!%notbeforeclose[@236c]~ @5-236c
noback pass3 _!%notbeforeclose[@236c]@2 @5-236c
noback pass3 _!%notbeforeclose[@236c]@3 @5-236c
noback pass3 _!%notbeforeclose[@236c]@25 @5-236c
noback pass3 _!%notbeforeclose[@236c]@23c @5-236c
noback pass3 _!%notbeforeclose[@26c]$s @5-26c
noback pass3 _!%notbeforeclose[@26c]~ @5-26c
noback pass3 _!%notbeforeclose[@26c]@2 @5-26c
noback pass3 _!%notbeforeclose[@26c]@3 @5-26c
noback pass3 _!%notbeforeclose[@26c]@25 @5-26c
noback pass3 _!%notbeforeclose[@26c]@23c @5-26c

# Step B (pass3): Opening signs (¿ ¡ " « “ () before lowercase without @46/@3456/@5 (§4.2.2)
# Note: Explicit single-cell replacements (no *) keep match.endReplace as newPos so
# lookahead context (@46, @3456, @5, $s, %openablec, trailing punct/EOF) is NEVER consumed.
noback pass3 [@235c]%openablec @235c
noback pass3 [@236c]%openablec @236c
noback pass3 [@126c]%openablec @126c
noback pass3 [@26c]%openablec @26c
noback pass3 [@235c]@46 @235c
noback pass3 [@236c]@46 @236c
noback pass3 [@126c]@46 @126c
noback pass3 [@26c]@46 @26c
noback pass3 [@235c]@3456 @235c
noback pass3 [@236c]@3456 @236c
noback pass3 [@126c]@3456 @126c
noback pass3 [@26c]@3456 @26c
noback pass3 [@235c]@5 @235c
noback pass3 [@236c]@5 @236c
noback pass3 [@126c]@5 @126c
noback pass3 [@26c]@5 @26c
noback pass3 [@235c]~ @235c
noback pass3 [@236c]~ @236c
noback pass3 [@126c]~ @126c
noback pass3 [@26c]~ @26c
noback pass3 [@235c]@2 @235c
noback pass3 [@236c]@2 @236c
noback pass3 [@126c]@2 @126c
noback pass3 [@26c]@2 @26c
noback pass3 [@235c]@3 @235c
noback pass3 [@236c]@3 @236c
noback pass3 [@126c]@3 @126c
noback pass3 [@26c]@3 @26c
noback pass3 [@235c]@25 @235c
noback pass3 [@236c]@25 @236c
noback pass3 [@126c]@25 @126c
noback pass3 [@26c]@25 @26c
noback pass3 [@235c]@23c @235c
noback pass3 [@236c]@23c @236c
noback pass3 [@126c]@23c @126c
noback pass3 [@26c]@23c @26c
# The dash of an aside (single cell 36) is an opening sign only in front of a lower case
# letter: no dot 5 in front of a capital letter, a number or punctuation (§4.2.2). A
# closing dash never gets one.
noback pass3 [@36c]%openablec @36c
noback pass3 [@36c]@46 @36c
noback pass3 [@36c]@3456 @36c
noback pass3 [@36c]@5 @36c
noback pass3 [@36c]~ @36c
noback pass3 [@36c]@2 @36c
noback pass3 [@36c]@3 @36c
noback pass3 [@36c]@25 @36c
noback pass3 [@36c]@23c @36c
noback pass3 _$s[@235c]!$s @5-235c
noback pass3 _$s[@236c]!$s @5-236c
noback pass3 _$s[@126c]!$s @5-126c
noback pass3 _$s[@26c]!$s @5-26c
noback pass3 `[@235c]!$s @5-235c
noback pass3 `[@236c]!$s @5-236c
noback pass3 `[@126c]!$s @5-126c
noback pass3 `[@26c]!$s @5-26c
noback pass3 _%openablec[@235c]!$s @5-235c
noback pass3 _%openablec[@236c]!$s @5-236c
noback pass3 _%openablec[@126c]!$s @5-126c
noback pass3 _%openablec[@26c]!$s @5-26c
noback pass3 _$s[@36c]!$s @5-36c
noback pass3 `[@36c]!$s @5-36c
noback pass3 _%openablec[@36c]!$s @5-36c

# Step D (pass3): Tabla 23 — ';' after '-bre' (dots 23) and '*' before word
noback pass3 _@23[@23c] @5-23c
noback pass3 _$s[@35c]!$s @5-35c
noback pass3 `[@35c]!$s @5-35c

# Strip virtual dots b and c in pass4
noback pass4 %kw %kw
noback pass4 %punctc %punctc

