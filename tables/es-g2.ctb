noback correct !$l["Cuba"]~ "\xe016"
noback correct !$l["Cuba"]!$l "\xe016"
noback sign \xe017 456-15-14
noback correct `["Ecuador"]~ "\xe017"
noback correct `["Ecuador"]!$l "\xe017"
noback correct !$l["Ecuador"]~ "\xe017"
noback correct !$l["Ecuador"]!$l "\xe017"
