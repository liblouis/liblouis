# ----------------------------------------------------------------------
# Character classes for Principios, Secuencias & Contracciones
# ----------------------------------------------------------------------
attribute consonants BbCcDdFfGgHhJjKkLlMmNnPpQqRrSsTtVvWwXxYyZzÑñ
attribute vowels AaEeIiOoUuÁáÉéÍíÓóÚúÜü
attribute euvowels Gg

# g + ue cannot use ue (1256) because it could be confused with ü (1256) (§3.4.2.5)
noback context %euvowels["u"]"e" @136
noback context %euvowels["U"]"e" @46-136
noback context %euvowels["u"]"E" @136
noback context %euvowels["U"]"E" @46-136

# on and ion contractions only occur after consonants (§3.4)
after consonants always on 1346
after consonants always ion 3456

# ----------------------------------------------------------------------
# Word endings — Terminaciones (CBE B 16-1 V3 §3.2 Tablas 12-14 & §3.2.2)
# Placed before partwords so endings always win over overlapping internal contractions.
