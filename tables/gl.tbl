#-index-name: Galician
#-display-name: Galician braille

#+language:gl
#+type:literary
#+contraction:no
#+grade:1

# Galician literary braille uses the Spanish braille character set and rules
# per Comisión Braille Española (CBE) B 2 V4 (2025-05-23), §5.2.

include es-g1.ctb
include braille-patterns.cti
