#+language:id
#+type:literary
#+contraction:no
#+grade:1
#+dots:6
#+direction:both
#+version:2000
#-index-name: Indonesian, uncontracted
#-display-name: Indonesian uncontracted braille
#-author: Muhammad <muha.aku@gmail.com>
#-license: LGPLv2.1
#-updated: 2026-11-26

# Notes
# -----
# This table implements uncontracted Indonesian braille as defined in
# Sistem Simbol Braille Indonesia Bidang Bahasa Indonesia, Keputusan
# Menteri Pendidikan Nasional Nomor 053/U/2000 (Departemen Pendidikan
# Nasional, Jakarta, 2000). This decree is still the reference cited by
# the Indonesian Ministry of Education, for example in Panduan Guru
# Pembelajaran Braille Lanjutan (Kemendikbudristek, 2024).
#
# The rules were taken from Didi Tarsidi, Belajar Braille dalam 6 Modul,
# Modul 2: Braille Dasar (Universitas Pendidikan Indonesia, 2010), which
# follows that decree, and from Modul 4 of the same course for the
# thousands separator and the decimal comma.
#
# Symbols that the course does not give for text, such as @, & and #,
# follow the grade 1 rules of Mitranetra Braille Converter 5 (Yayasan
# Mitra Netra, 2010). See the comment above them.
#
# Not defined yet: ^ | ~, the en and em dashes, the bullet, the
# currency signs other than $, the degree sign, the section and
# paragraph signs, the copyright, registered and trademark signs,
# guillemets, the inverted question and exclamation marks, and letters
# with diacritics such as é and ñ. Neither the course nor Mitranetra
# Braille Converter gives signs for them in text.

include spaces.uti

# Letters a-z are the international Latin braille letters.
include latinLetterDef6Dots.uti

# Digits: the number sign followed by the letters a-j.
include digits6Dots.uti
include litdigits6Dots.uti
numsign 3456

# Tanda pugar (dots 5-6) separates a letter a-j from a number that
# precedes it, as in 2b, 2B and 14d. It is not needed for a letter
# before a number, as in B2.
nonumsign 56
numericnocontchars abcdefghijABCDEFGHIJ

# Before a capital letter, tanda pugar comes first and the capital sign
# second, as in 2B.
noback pass2 @6-56 @56-6

# Within a number, dot 2 separates the thousands (15.000) and dots 4-6
# are the decimal comma (2,5). Neither ends the number.
midnum . 2
decpoint , 46
midendnumericmodechars .,

# Tanda kapital (dot 6) before a capital letter, and twice before a word
# written in capitals, such as TVRI. Roman numerals follow the same rule.
capsletter 6
begcapsword 6-6

# Tanda kursif (dots 4-6) marks italic, bold and underlined text. It is
# written before the word. For three words or more, it is written twice
# before the first word and once before the last word.
emphclass italic
emphclass underline
emphclass bold
begemphword italic 46
begemphword underline 46
begemphword bold 46
begemphphrase italic 46-46
endemphphrase italic before 46
lenemphphrase italic 3
begemphphrase underline 46-46
endemphphrase underline before 46
lenemphphrase underline 3
begemphphrase bold 46-46
endemphphrase bold before 46
lenemphphrase bold 3

# Punctuation (Tabel 2.4 of Modul 2).
punctuation . 256
punctuation , 2
punctuation ; 23
punctuation : 25
punctuation ? 236
punctuation ! 235
punctuation ' 3
punctuation \x2019 3 # right single quotation mark, used as apostrophe
punctuation \x2018 3 # left single quotation mark
punctuation ( 2356
punctuation ) 2356
prepunc ( 2356
postpunc ) 2356
punctuation - 36
punctuation / 34
punctuation " 236
punctuation \x201c 236 # left double quotation mark
punctuation \x201d 356 # right double quotation mark
punctuation \x2026 3-3-3 # horizontal ellipsis
sign * 35-35
math \x00b1 26-35 # plus-minus sign

hyphen - 36

# The opening and closing quotation marks differ. An opening quotation
# mark has the same dots as the question mark.
prepunc " 236
postpunc " 356

# The ellipsis is three apostrophes, not three periods. Four periods are
# an ellipsis followed by a period, as in Mitranetra Braille Converter 5.
always ... 3-3-3
always .... 3-3-3-256
# An ellipsis between two numbers ends the first number, so the number
# sign is written again before the second, as in 5...10.
midnum ... 3-3-3-3456

# Signs of arithmetic, from Modul 4 of the course (Tabel 4.1). The
# minus sign (dots 3-5) and the brackets of mathematics (dots 2-4-6 and
# 1-3-5) are left out, because in text the hyphen and the parentheses
# keep their signs of Tabel 2.4.
math \x00d7 16 # multiplication sign
math \x00f7 34-34 # division sign
noback math \x00b2 126 # superscript two, read back as <
math \x00b3 146 # superscript three

# Symbols that the course does not give for text. These follow the
# grade 1 rules (mibi1.tab) of Mitranetra Braille Converter 5, an
# Indonesian braille translation program by Yayasan Mitra Netra.
math = 25-25
noback math + 1234-123-136-234 # spelt as the letters "plus"
math < 126
noback math > 356 # same as the closing quotation mark
sign @ 4
noback sign # 3456 # same as the number sign
sign $ 1246
noback sign % 1234-234 # the letters "ps", as in Modul 4
sign & 4-12346
sign \\ 4-1256
# The underscore is dots 4-5-6, as on the iOS braille keyboard and in
# Braille ASCII. Mitranetra Braille Converter uses dots 4-6, but those
# are the decimal comma and the italic sign.
sign _ 456
sign ` 6-3
punctuation [ 246
punctuation ] 12456
punctuation { 6-236
punctuation } 356-3

# Back-translation of signs that have two meanings.
#
# The number sign alone is #: before another number sign (#1), before
# a space or at the end. Before a letter a-j it starts a number, so a
# word such as #indonesia cannot be told from a number.
nofor context [@3456]@3456 "#"
nofor context [@3456]@0 "#"
nofor context [@3456]~ "#"
# Before a letter k-z it is # too, as in #saya.
nofor context [@3456]@13 "#"
nofor context [@3456]@123 "#"
nofor context [@3456]@134 "#"
nofor context [@3456]@1345 "#"
nofor context [@3456]@135 "#"
nofor context [@3456]@1234 "#"
nofor context [@3456]@12345 "#"
nofor context [@3456]@1235 "#"
nofor context [@3456]@234 "#"
nofor context [@3456]@2345 "#"
nofor context [@3456]@136 "#"
nofor context [@3456]@1236 "#"
nofor context [@3456]@2456 "#"
nofor context [@3456]@1346 "#"
nofor context [@3456]@13456 "#"
nofor context [@3456]@1356 "#"
# Dots 3-5-6 with a space on both sides are the greater-than sign. At
# the end of a word they are the closing quotation mark.
nofor context [@0-356-0] "\s>\s"

# Unicode braille
include braille-patterns.cti
