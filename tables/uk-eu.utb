# =====================================================================
#  GENERAL MATH SYMBOLS
# =====================================================================

noback math + 235
nofor math + 56-235
noback math \x2212 36            # − minus
nofor math \x2212 56-36
noback math = 2356
nofor math = 56-2356
noback math \x00d7 3             # × multiply
nofor math \x00d7 56-3
noback math \x00f7 256           # ÷ divide
nofor math \x00f7 56-256
noback math \x00b1 235-36        # ±
noback math > 135
noback math < 246
noback math \x2265 135-2356      # ≥
noback math \x2264 246-2356      # ≤
noback math \x2260 23456         # ≠
math % 3456-356
noback math \x2030 3456-356-356  # ‰
noback math \x2116 1345          # №
noback math \x2248 26-26         # ≈
math \x00b0 46-356               # °
noback math \x2103 46-356-46-14  # ℃
noback math \x00bd 3456-1-23     # ½
noback math \x00bc 3456-1-256    # ¼
noback math \x00be 3456-14-256   # ¾
noback sign \x00b5 56-134        # µ micro
noback math \x00b9 346-2         # ¹ superscript = upper index 346 + lowered digit
noback math \x00b2 346-23        # ² (m², km²)
noback math \x00b3 346-25        # ³ (m³)

# Arrows
noback math \x2190 246-25        # ←
noback math \x2191 56-34         # ↑
noback math \x2192 25-135        # →
noback math \x2193 45-16         # ↓

