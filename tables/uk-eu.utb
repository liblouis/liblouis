base uppercase \x039b \x03bb   # Λ
base uppercase \x039c \x03bc   # Μ
base uppercase \x039d \x03bd   # Ν
base uppercase \x039e \x03be   # Ξ
base uppercase \x039f \x03bf   # Ο
base uppercase \x03a0 \x03c0   # Π
base uppercase \x03a1 \x03c1   # Ρ
base uppercase \x03a3 \x03c3   # Σ
base uppercase \x03a4 \x03c4   # Τ
