noback lowercase \x03ad 4-15     # έ
noback lowercase \x03ae 4-245    # ή
noback lowercase \x03af 4-24     # ί
noback lowercase \x03cc 4-135    # ό
noback lowercase \x03cd 4-136    # ύ
noback lowercase \x03ce 4-2456   # ώ
noback lowercase \x03ca 24       # ϊ
noback lowercase \x03cb 136      # ϋ
noback lowercase \x0390 4-24     # ΐ
noback lowercase \x03b0 4-136    # ΰ
noback math \x03d5 56-124        # ϕ phi symbol

base uppercase \x0391 \x03b1   # Α
base uppercase \x0392 \x03b2   # Β
base uppercase \x0393 \x03b3   # Γ
base uppercase \x0394 \x03b4   # Δ
