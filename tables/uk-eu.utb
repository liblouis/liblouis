# liblouis: Ukrainian literary braille with extended European letter support
#
#-index-name: Ukrainian, with European letters
#-display-name: Ukrainian braille with European letters
#
#+language: uk
#+type: literary
#+dots: 6
#+contraction: no
#+direction: both
#+variant: european
#
#-license: LGPLv2.1
#-maintainer: Sergiy Moskalets <www.trosti.com.ua>
#-copyright: Sergiy Moskalets
#-copyright: Igor B. Poretsky
#-copyright: Andrey Yakuboy
#-copyright: Bert Frees

