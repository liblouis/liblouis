# =====================================================================
#  DESIGN DECISIONS & LANGUAGE COVERAGE SPECIFICATION:
# =====================================================================
#  Native Ukrainian braille is the foundation. European letters are added
#  with a strict 1:1 Unicode mapping (one code point = one braille form),
#  so a QWERTY-based display (e.g. Mantis Q40) can read many languages
#  without switching national profiles.
#
#  HOW DOT PATTERNS FOR FOREIGN LETTERS WERE CHOSEN:
#  1. A letter used by one language gets that language's official dots
#     (as implemented in the national liblouis tables).
#  2. A letter shared by several languages (ó, ú, á, č, š ...) gets the
#     value used by most of them; Polish has priority for ó (346).
#  3. If the national value would merge two letters of the SAME language,
#     a collision-free value is used instead (ē, ķ, ļ, ġ, ű).
#  Remaining unavoidable merges inside one language (6 dots = 63 cells):
#     CS ú/ů (same sound), SK ď/ô, HR č/ć, LT ę/š, ET õ/ö,
#     PT á/â, RO ă/â.
#
#  PUNCTUATION RULE:
#  Dots 126 for '(' and 345 for ')' are kept. ')' shares 345 with 'є';
#  on a Perkins keyboard 345 is typed back as 'є'.
#
#  ASYMMETRIC BACK-TRANSLATION (The Perkins Priority Rule):
#  All foreign characters use 'noback'. Typing on a 6-key braille keyboard
#  always gives native Ukrainian letters. The Ukrainian alphabet is defined
#  BEFORE punctuation, so 345 = є and 1456 = ї (not ')' and '#').
# =====================================================================

# Braille indicators:
numsign 3456

# Emphasis indication signs:
emphclass italic
emphclass underline
emphclass bold
begemphword italic 46
endemphword italic 46
begemphphrase italic 46
endemphphrase italic after 46
begemphword bold 45-456
endemphword bold 45-456
begemphphrase bold 45-456
endemphphrase bold after 45-456
begemphword underline 456
endemphword underline 456
begemphphrase underline 456
endemphphrase underline after 456

# ----------- Spaces --------------------------------------------------
include spaces.uti
replace \x0007 \s

# Compose decomposed Cyrillic letters before translation
noback correct "\x0438\x0306" "\x0439"   # и + breve = й
noback correct "\x0418\x0306" "\x0419"   # И + breve = Й
noback correct "\x0456\x0308" "\x0457"   # і + diaeresis = ї
noback correct "\x0406\x0308" "\x0407"   # І + diaeresis = Ї
noback correct "\x0435\x0308" "\x0451"   # е + diaeresis = ё
noback correct "\x0415\x0308" "\x0401"   # Е + diaeresis = Ё
noback correct "\x0443\x0306" "\x045e"   # у + breve = ў
noback correct "\x0423\x0306" "\x040e"   # У + breve = Ў

# =====================================================================
#  THE ALPHABET (Ukrainian native base) - defined first = wins back-translation
# =====================================================================

lowercase \x0430 1          # а
lowercase \x0431 12         # б
lowercase \x0432 2456       # в
lowercase \x0433 1245       # г
lowercase \x0491 12456      # ґ
lowercase \x0434 145        # д
lowercase \x0435 15         # е
lowercase \x0454 345        # є
lowercase \x0436 245        # ж
lowercase \x0437 1356       # з
lowercase \x0438 24         # и
lowercase \x0456 13456      # і
lowercase \x0457 1456       # ї
lowercase \x0439 12346      # й
lowercase \x043a 13         # к
lowercase \x043b 123        # л
lowercase \x043c 134        # м
lowercase \x043d 1345       # н
lowercase \x043e 135        # о
lowercase \x043f 1234       # п
lowercase \x0440 1235       # р
lowercase \x0441 234        # с
lowercase \x0442 2345       # т
lowercase \x0443 136        # у
lowercase \x0444 124        # ф
lowercase \x0445 125        # х
lowercase \x0446 14         # ц
lowercase \x0447 12345      # ч
lowercase \x0448 156        # ш
lowercase \x0449 1346       # щ
lowercase \x044c 23456      # ь
lowercase \x044e 1256       # ю
lowercase \x044f 1246       # я

base uppercase \x0410 \x0430   # А
base uppercase \x0411 \x0431   # Б
base uppercase \x0412 \x0432   # В
base uppercase \x0413 \x0433   # Г
base uppercase \x0490 \x0491   # Ґ
base uppercase \x0414 \x0434   # Д
base uppercase \x0415 \x0435   # Е
base uppercase \x0404 \x0454   # Є
base uppercase \x0416 \x0436   # Ж
base uppercase \x0417 \x0437   # З
base uppercase \x0418 \x0438   # И
base uppercase \x0406 \x0456   # І
base uppercase \x0407 \x0457   # Ї
base uppercase \x0419 \x0439   # Й
base uppercase \x041a \x043a   # К
base uppercase \x041b \x043b   # Л
base uppercase \x041c \x043c   # М
base uppercase \x041d \x043d   # Н
base uppercase \x041e \x043e   # О
base uppercase \x041f \x043f   # П
base uppercase \x0420 \x0440   # Р
base uppercase \x0421 \x0441   # С
base uppercase \x0422 \x0442   # Т
base uppercase \x0423 \x0443   # У
base uppercase \x0424 \x0444   # Ф
base uppercase \x0425 \x0445   # Х
base uppercase \x0426 \x0446   # Ц
base uppercase \x0427 \x0447   # Ч
base uppercase \x0428 \x0448   # Ш
base uppercase \x0429 \x0449   # Щ
base uppercase \x042c \x044c   # Ь
base uppercase \x042e \x044e   # Ю
base uppercase \x042f \x044f   # Я

# Ukrainian apostrophe variants (U+02BC is the officially recommended one)
noback sign \x02bc 3             # ʼ modifier letter apostrophe

# =====================================================================
#  PUNCTUATION
# =====================================================================

punctuation , 2                  # 44 comma
punctuation . 256                # 46 period
punctuation ! 235                # 33
noback punctuation " 236         # 34
sign # 1456                      # 35 (Perkins 1456 = ї)
sign $ 4-145                     # 36
sign & 6-12346                   # 38
punctuation ' 3                  # 39 apostrophe
punctuation ( 126                # 40
punctuation ) 345                # 41 (Perkins 345 = є)
sign * 35                        # 42
punctuation - 36                 # 45
math / 6-34                      # 47
punctuation : 25                 # 58
punctuation ; 23                 # 59
punctuation ? 26                 # 63
sign @ 146                       # 64
noback punctuation [ 12356       # 91
nofor punctuation [ 6-12356      # 91
sign \\ 6-16                     # 92
noback punctuation ] 23456       # 93
nofor punctuation ] 6-23456      # 93
sign ^ 56-26                     # 94 circumflex accent
sign _ 456                       # 95 underscore
sign ` 4                         # 96 grave accent
noback punctuation { 246         # 123
nofor punctuation { 4-246        # 123
noback sign | 456                # 124
nofor sign | 6-456               # 124
noback punctuation } 135         # 125
nofor punctuation } 4-135        # 125
noback sign ~ 26                 # 126 tilde

# Quotation marks, dashes, typography (values as in ru-litbrl.ctb)
punctuation \x00ab 236           # « left guillemet
punctuation \x00bb 356           # » right guillemet
noback punctuation \x201e 236    # „ double low-9 quotation mark
noback punctuation \x201c 236    # “ left double quotation mark
noback punctuation \x201d 356    # ” right double quotation mark
noback punctuation \x201a 236    # ‚ single low-9 quotation mark
noback punctuation \x2039 236    # ‹ single left angle quotation mark
noback punctuation \x203a 356    # › single right angle quotation mark
noback punctuation \x2013 36     # – en dash
noback punctuation \x2014 36     # — em dash
noback punctuation \x2012 36     # ‒ figure dash
noback punctuation \x2015 36     # ― horizontal bar
noback punctuation \x2010 36     # ‐ hyphen
noback punctuation \x2011 36     # ‑ non-breaking hyphen
noback punctuation \x00ad 36     # soft hyphen
noback punctuation \x2026 256-256-256  # … ellipsis
noback punctuation \x00a1 235    # ¡ (Spanish, same as !)
noback punctuation \x00bf 26     # ¿ (Spanish, same as ?)
noback sign \x00b7 56            # · middle dot (Catalan l·l)
noback sign \x2022 56-35         # • bullet
noback sign \x00a7 346           # § section sign
noback sign \x00b6 6-1234-345    # ¶ pilcrow
noback sign \x00a9 126-14-345    # © = (c)
noback sign \x00ae 126-1235-345  # ® = (r)
noback sign \x2122 126-2345-134-345  # ™ = (tm)

# Currency
noback sign \x20ac 4-15          # € euro
noback sign \x00a3 4-123         # £ pound
noback sign \x00a5 4-13456       # ¥ yen
noback sign \x20b4 4-1245        # ₴ hryvnia
noback sign \x20bd 4-1235        # ₽ ruble
noback sign \x00a2 4-14          # ¢ cent

# =====================================================================
#  DIGITS AND BASIC LATIN ALPHABET
# =====================================================================

include litdigits6Dots.uti
include latinLetterDef6Dots.uti

# =====================================================================
#  EXTENDED EUROPEAN SUPPORT (Strict 1:1 Unicode Mapping, forward only)
# =====================================================================

# ---------------------------------------------------------------------
# 1. German, Danish, Norwegian, Swedish, Finnish (all = national)
