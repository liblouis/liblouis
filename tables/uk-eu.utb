noback lowercase \x00e6 345        # æ
noback lowercase \x00f6 246        # ö
noback lowercase \x00f8 246        # ø
noback lowercase \x00fc 1256       # ü
noback lowercase \x00e5 16         # å
noback lowercase \x00df 2346       # ß

base uppercase \x00c4 \x00e4       # Ä
base uppercase \x00c6 \x00e6       # Æ
base uppercase \x00d6 \x00f6       # Ö
base uppercase \x00d8 \x00f8       # Ø
base uppercase \x00dc \x00fc       # Ü
base uppercase \x00c5 \x00e5       # Å
base uppercase \x1e9e \x00df       # ẞ

