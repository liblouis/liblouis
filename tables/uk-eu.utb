# ---------------------------------------------------------------------
# 6. Baltic languages
# ---------------------------------------------------------------------
noback lowercase \x0101 16         # ā
noback lowercase \x0113 126        # ē (national 156 would merge with š)
noback lowercase \x012b 246        # ī
noback lowercase \x016b 1256       # ū (LT national; LV uses 346 = ų)
noback lowercase \x012f 246        # į
noback lowercase \x0173 346        # ų
