noback correct "u\x0308" "ü"	# ü	Latin small letter u + combining diaeresis
noback correct "A\x030A" "Å"	# Å	Latin capital letter a + combining ring above
noback correct "a\x030A" "å"	# å	Latin small letter a + combining ring above
noback correct "C\x0327" "Ç"	# Ç	Latin capital letter c + combining cedilla
noback correct "c\x0327" "ç"	# ç	Latin small letter c + combining cedilla

