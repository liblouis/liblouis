comp6 \x00C1 46-12356	# Á ⠨⠷
comp6 \x00C2 46-16	# Â ⠨⠡
comp6 \x00C3 46-345	# Ã ⠨⠜
comp6 \x00C7 46-12346	# Ç ⠨⠯
comp6 \x00C9 46-123456	# É ⠨⠿
