# liblouis: Spanish 8-dot Chemistry Braille Table (CBE B 14-2 V1)
#
# -----------
#-index-name: Spanish, chemistry, 8-dot
#-display-name: Spanish 8-dot chemical braille
# Note: "8-dot" distinguishes this code (CBE B 14-2) from the 6-dot
# Spanish chemistry braille codes (CBE B 6-1 linear and B 6-2 2D).
#
#+language:zxx
#+region:es
#+type:chemistry
#+system:cbe-b14-2
#+dots:8
#+unicode-range: ucs4
#+direction:forward
